# This file allows some options or operations to be overriden based on the path to each repo

[includeIf "gitdir:~/workspace/adidas/"]
  path = ~/workspace/adidas/.gitconfig

[includeIf "gitdir:~/workspace/lendismart/"]
  path = ~/workspace/lendismart/.gitconfig

[includeIf "gitdir:~/workspace/pixsy/"]
  path = ~/workspace/pixsy/.gitconfig

